      <column caption='Agency' datatype='string' name='[Calculation_0849922547011585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER([classification_desc (mts_table_5)])' />
      </column>
      <column caption='Function' datatype='string' name='[Calculation_0849922549719042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(PROPER([classification_desc (mts_table_9)]),&quot;, And Social Services&quot;,&quot; And Social Services&quot;)' />
      </column>
      <column caption='Coverage Range' datatype='string' name='[Calculation_1478354035412992]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(DATENAME(&quot;month&quot;,MIN([record_date]))) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,MIN([record_date]))) &#13;&#10;+ &quot; THRU &quot; +&#13;&#10;STR(DATENAME(&quot;month&quot;,MAX([record_date]))) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,MAX([record_date])))' />
      </column>
      <column caption='Fiscal Year' datatype='string' name='[Calculation_1511887473205248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FY &quot; + STR([record_fiscal_year])' />
