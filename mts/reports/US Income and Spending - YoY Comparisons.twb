      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0kkkuad1vhc6ek1fz3gg111wrgg7].[pcto:sum:current_month_net_outly_amt:qk:2]&quot;' value='% of Total FY Agency Spend' />
          <alias key='&quot;[federated.0kkkuad1vhc6ek1fz3gg111wrgg7].[pcto:sum:current_month_net_rcpt_amt:qk:2]&quot;' value='% of Total for FY' />
          <alias key='&quot;[federated.0kkkuad1vhc6ek1fz3gg111wrgg7].[pcto:sum:current_month_rcpt_outly_amt:qk:2]&quot;' value='% of FY Total Spent' />
          <alias key='&quot;[federated.0kkkuad1vhc6ek1fz3gg111wrgg7].[usr:Calculation_1180935110828034:qk]&quot;' value='Percent of Spend on Interest' />
        </aliases>
      </column>
      <column caption='President and Party' datatype='string' name='[Calculation_0849922542075904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[president_name] + &quot; (&quot; + [president_party] + &quot;)&quot;' />
      </column>
      <column caption='Agency' datatype='string' name='[Calculation_0849922547011585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER([classification_desc (mts_table_5)])' />
      </column>
      <column caption='Function' datatype='string' name='[Calculation_0849922549719042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(PROPER([classification_desc (mts_table_9)]),&quot;, And Social Services&quot;,&quot; And Social Services&quot;)' />
      </column>
      <column caption='Interest Payments' datatype='real' default-format='c&quot;$&quot;#,##0,,,B;(&quot;$&quot;#,##0,,,B)' name='[Calculation_1180935110152193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([Calculation_0849922547011585],&quot;Issues (&quot;) THEN&#13;&#10;[current_month_net_outly_amt]&#13;&#10;END' />
      </column>
      <column caption='Percent of Spent on Interest' datatype='real' default-format='p0.0%' name='[Calculation_1180935110828034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1180935110152193]) / SUM([current_month_net_outly_amt])' />
      </column>
      <column caption='Coverage Range' datatype='string' name='[Calculation_1478354035412992]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(DATENAME(&quot;month&quot;,MIN([record_date]))) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,MIN([record_date]))) &#13;&#10;+ &quot; THRU &quot; +&#13;&#10;STR(DATENAME(&quot;month&quot;,MAX([record_date]))) + &quot;-&quot; + STR(DATEPART(&quot;year&quot;,MAX([record_date])))' />
      </column>
      <column caption='Fiscal Year' datatype='string' name='[Calculation_1511887473205248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FY &quot; + STR([record_fiscal_year])' />
      </column>
      <column caption='Deficit' datatype='real' default-format='c&quot;$&quot;#,##0,,,B;(&quot;$&quot;#,##0,,,B)' name='[Calculation_2262579260366851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([current_month_net_outly_amt]) - SUM([current_month_net_rcpt_amt])' />
      </column>
      <column caption='FY Months' datatype='date' fiscal-year-start='10' name='[Months]' role='dimension' type='ordinal' user:agg-type='Month-Trunc' user:base-field='record_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [record_date]))' scope-isolation='false' />
      </column>
      <column aggregation='Sum' caption='Months' datatype='integer' fiscal-year-start='10' name='[Record Date (Months)]' role='dimension' type='ordinal' user:agg-type='Month' user:base-field='record_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;,3,[record_date]))' scope-isolation='false' />
      </column>
